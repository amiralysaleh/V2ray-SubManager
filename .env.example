# GitHub Personal Access Token (classic) with "gist" scope
# This is injected at BUILD TIME via VITE_GITHUB_TOKEN.
# For local dev: set in .env (not committed) or pass inline:
#   VITE_GITHUB_TOKEN=ghp_xxx npm run dev
#
# For GitHub Pages: set MY_GH_TOKEN as a repository secret
# and wire it in .github/workflows/deploy.yml:
#   env: VITE_GITHUB_TOKEN: ${{ secrets.MY_GH_TOKEN }}
#
# Get a token at: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=ghp_your_token_here